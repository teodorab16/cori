---
// Hero doodle: a heart runs the route from trainer to coffee. Decorative only.
// The path starts and ends at mid-height (y = 35) so it meets both icons dead centre.
import Icon from './Icon.astro';

const ROUTE = 'M4 35 C 44 -4, 76 74, 120 35 S 196 -4, 236 35';
---
<div class="route" data-route aria-hidden="true">
  <div class="route__end">
    <Icon name="sneaker" class="route__icon route__sneaker" />
    <span class="route__label mono">run</span>
  </div>
  <svg class="route__svg" viewBox="0 0 240 70" fill="none">
    <path class="route__track" d={ROUTE} />
    <path class="route__line" data-route-line d={ROUTE} />
    <g class="route__runner" data-route-runner>
      <path transform="translate(-9 -9) scale(0.75)" fill="currentColor" d="M12 20.5c-.4 0-.8-.1-1.1-.4C6.6 16.6 2.5 13.2 2.5 9 2.5 6.2 4.6 4 7.3 4c1.9 0 3.6 1 4.7 2.6C13.1 5 14.8 4 16.7 4c2.7 0 4.8 2.2 4.8 5 0 4.2-4.1 7.6-8.4 11.1-.3.3-.7.4-1.1.4z" />
    </g>
  </svg>
  <div class="route__end">
    <Icon name="coffee" class="route__icon route__coffee" />
    <span class="route__label mono">brunch</span>
  </div>
</div>
