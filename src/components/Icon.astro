---
// Line icons drawn for cori: 32px grid, 2px rounded strokes, currentColor.
interface Props {
  name: 'sneaker' | 'coffee' | 'phone' | 'keys' | 'gel' | 'balm' | 'sunnies' | 'layer' | 'flask' | 'mail' | 'heart';
  class?: string;
  label?: string;
  size?: number; // needed when the icon is nested inside another <svg>
}
const { name, class: className, label, size } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---
<svg class:list={['icon', `icon--${name}`, className]} width={size} height={size} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" {...a11y}>
  {name === 'sneaker' && (
    <g>
      <path d="M3 22.5c0-4 2.2-6.5 5.5-6.5H12l4.5-5c1.2-1.3 3.2-1.3 4.4 0l3.4 3.6c2.6 1.1 4.7 2.6 4.7 5.4v2.5c0 .8-.7 1.5-1.5 1.5h-23c-.8 0-1.5-.7-1.5-1.5Z" />
      <path d="M3.2 21.5h25.6" />
      <path d="M17 13.5l2 2M14.8 15.4l2 2" />
    </g>
  )}
  {name === 'coffee' && (
    <g>
      <path class="steam" d="M12 3.5c-1.6 1.5 1.6 2.5 0 4.5M17 3.5c-1.6 1.5 1.6 2.5 0 4.5" />
      <path d="M6 11h16v7a6 6 0 0 1-6 6h-4a6 6 0 0 1-6-6v-7Z" />
      <path d="M22 13h1.5a3 3 0 0 1 0 6H22" />
      <path d="M4 28h20" />
    </g>
  )}
  {name === 'phone' && (
    <g>
      <rect x="9" y="3" width="14" height="26" rx="3" />
      <path d="M14 6.5h4M15 25h2" />
    </g>
  )}
  {name === 'keys' && (
    <g>
      <circle cx="10" cy="10" r="5" />
      <path d="M13.5 13.5 26 26M21 21l2.5-2.5M24 24l2-2" />
    </g>
  )}
  {name === 'gel' && (
    <g>
      <path d="M11 3h10l-2 6v19h-6V9l-2-6Z" />
      <path d="M13 15h6M13 19h6" />
    </g>
  )}
  {name === 'balm' && (
    <g>
      <rect x="11" y="11" width="10" height="18" rx="2" />
      <path d="M12.5 11V7.5c0-2 1.6-4.5 3.5-4.5s3.5 2.5 3.5 4.5V11" />
    </g>
  )}
  {name === 'sunnies' && (
    <g>
      <path d="M3 13h26" />
      <path d="M4 13c0 4.4 1.8 7 5 7s5-2.6 5-7M18 13c0 4.4 1.8 7 5 7s5-2.6 5-7" />
      <path d="M14 14.5c1.2-1 2.8-1 4 0" />
    </g>
  )}
  {name === 'layer' && (
    <g>
      <path d="M11 5 6 8 3 14l4 2 2-3v15h14V13l2 3 4-2-3-6-5-3c-.6 2-2.6 3.5-5 3.5S11.6 7 11 5Z" />
    </g>
  )}
  {name === 'flask' && (
    <g>
      <path d="M13 3h6v4l2 2v17a3 3 0 0 1-3 3h-4a3 3 0 0 1-3-3V9l2-2V3Z" />
      <path d="M11 15h10" />
    </g>
  )}
  {name === 'mail' && (
    <g>
      <rect x="4" y="7" width="24" height="18" rx="3" />
      <path d="m5 9 11 8 11-8" />
    </g>
  )}
  {name === 'heart' && (
    <path fill="currentColor" stroke="none" d="M16 27.3c-.5 0-1-.2-1.4-.5C8.8 22.2 3.3 17.6 3.3 12A6.4 6.4 0 0 1 9.7 5.4c2.5 0 4.8 1.3 6.3 3.4 1.5-2.1 3.8-3.4 6.3-3.4a6.4 6.4 0 0 1 6.4 6.6c0 5.6-5.5 10.2-11.2 14.8-.4.3-.9.5-1.5.5Z" />
  )}
</svg>
