---
// Small looping illustrations for "How it works". Decorative only, never shows a real design.
interface Props {
  scene: 'deck' | 'bars' | 'notify';
}
const { scene } = Astro.props;
const HEART = 'M12 20.5c-.4 0-.8-.1-1.1-.4C6.6 16.6 2.5 13.2 2.5 9 2.5 6.2 4.6 4 7.3 4c1.9 0 3.6 1 4.7 2.6C13.1 5 14.8 4 16.7 4c2.7 0 4.8 2.2 4.8 5 0 4.2-4.1 7.6-8.4 11.1-.3.3-.7.4-1.1.4z';
// A tiny neutral vest glyph (outline only).
const VEST = 'M12 3h7c0 9 2 13 5 16v25q-9 3-17-2V20c4-3 5-8 5-17ZM40 3h-7c0 9-2 13-5 16v25q9 3 17-2V20c-4-3-5-8-5-17Z';
const bars = [
  { x: 34, h: 52 },
  { x: 82, h: 96 },
  { x: 130, h: 70 },
  { x: 178, h: 124, top: true },
  { x: 226, h: 40 },
];
---
<svg class={`scene scene--${scene}`} data-scene={scene} viewBox="0 0 280 180" fill="none" aria-hidden="true">
  {scene === 'deck' && (
    <g>
      <g data-card="2"><rect x="88" y="26" width="104" height="134" rx="14" class="scene__card scene__card--back" /><path d={VEST} transform="translate(114 62)" class="scene__glyph" /></g>
      <g data-card="1"><rect x="88" y="26" width="104" height="134" rx="14" class="scene__card scene__card--mid" /><path d={VEST} transform="translate(114 62)" class="scene__glyph" /></g>
      <g data-card="0"><rect x="88" y="26" width="104" height="134" rx="14" class="scene__card scene__card--front" /><path d={VEST} transform="translate(114 62)" class="scene__glyph" /></g>
      <g data-pop transform="translate(196 18)"><path d={HEART} transform="scale(1.6)" class="scene__heart" /></g>
    </g>
  )}
  {scene === 'bars' && (
    <g>
      <path d="M18 162h244" class="scene__base" />
      {bars.map((b, i) => (
        <g>
          <rect data-bar={i} x={b.x} y={162 - b.h} width="30" height={b.h} rx="6" class:list={['scene__bar', { 'scene__bar--top': b.top }]} />
          <g data-bar-heart={i} transform={`translate(${b.x + 4} ${162 - b.h - 26})`}><path d={HEART} class:list={['scene__heart', { 'scene__heart--muted': !b.top }]} /></g>
        </g>
      ))}
      <g data-made transform="translate(212 40)"><rect width="66" height="22" rx="11" class="scene__tag" /><text x="33" y="15" text-anchor="middle" class="scene__tag-text">made</text></g>
    </g>
  )}
  {scene === 'notify' && (
    <g>
      <g data-phone>
        <rect x="96" y="8" width="88" height="164" rx="18" class="scene__phone" />
        <path d="M128 18h24" class="scene__phone-detail" />
        <g data-bubble>
          <rect x="104" y="36" width="72" height="44" rx="12" class="scene__bubble" />
          <path d={HEART} transform="translate(110 46) scale(0.9)" class="scene__heart scene__heart--on-dark" />
          <path d="M136 52h32M136 63h22" class="scene__bubble-lines" />
        </g>
        <path d="M112 104h56M112 118h40M112 132h48" class="scene__phone-lines" />
      </g>
      <g data-waves>
        <path d="M80 70c-6 6-6 18 0 24M70 62c-10 10-10 30 0 40" class="scene__wave" />
        <path d="M200 70c6 6 6 18 0 24M210 62c10 10 10 30 0 40" class="scene__wave" />
      </g>
    </g>
  )}
</svg>
